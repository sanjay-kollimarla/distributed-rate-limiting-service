PORT=3000
RATE_LIMIT_STORE=redis
REDIS_URL=redis://localhost:6380
TRUST_PROXY=false
LOG_LEVEL=info
# Human-readable logs; defaults to on unless NODE_ENV=production
LOG_PRETTY=true
# Serves the demo UI at / and lets clients pick their own identity. Never enable in production.
DEMO_MODE=true
# When set, GET /metrics requires "Authorization: Bearer <token>"
METRICS_TOKEN=
# key=clientId:tier,...
API_KEYS=demo-premium-key=acme:premium,demo-standard-key=globex:standard
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_TIMEOUT_MS=10000
REDIS_CALL_TIMEOUT_MS=200
SHUTDOWN_TIMEOUT_MS=10000
